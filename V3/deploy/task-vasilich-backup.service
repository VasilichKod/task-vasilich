[Unit]
Description=Verified PostgreSQL backup for NePlan
After=postgresql.service
Requires=postgresql.service
OnSuccess=task-vasilich-cloud-backup.service

[Service]
Type=oneshot
User=root
ExecStart=/bin/bash /usr/local/lib/nedplan-backup/backup-database.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
