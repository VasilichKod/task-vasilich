[Unit]
Description=Task Vasilich V3 backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/task-vasilich/V3
EnvironmentFile=/var/www/task-vasilich/V3/.env
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/usr/bin/node --import tsx src/server/http/dev-server.ts
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
